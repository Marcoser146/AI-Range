# AI Gateway Service configuration
NODE_ENV=development
PORT=8080

# ---------------------------------------------------------------------------
# Service callers (range control plane, instructor dashboard)
# ---------------------------------------------------------------------------
# Bearer token for POST /v1/recommendations, /v1/assessments, /v1/reports*.
# In production (NODE_ENV=production) the gateway refuses to start if this
# is unset - no "change-me" fallback outside dev/test.
AI_GATEWAY_API_KEY=change-me

# Optional second service token for the instructor dashboard - also grants
# access to /v1/admin/*. Leave unset to use only chat-forwarded admin roles
# (see ADMIN_ROLES below) for admin access.
INSTRUCTOR_DASHBOARD_TOKEN=

# Set to "true" to disable all auth checks - local dev only, never in prod.
AI_GATEWAY_AUTH_DISABLED=false

# ---------------------------------------------------------------------------
# Chat tenants (one per enclave, connected over HWIL)
# ---------------------------------------------------------------------------
# Static per-enclave token each Open WebUI instance authenticates with
# (its OPENAI_API_KEY). Real deployments override the whole tenant table via
# TENANTS_JSON from group_vars; this single-tenant default is for local dev.
CHAT_DEFAULT_TENANT_TOKEN=change-me-chat

# JSON object: { "<tenant-id>": { "token": "...", "allowedModels": [...] | null } }
# allowedModels: null means "every configured model." Overrides the default
# single "default" tenant entirely when set.
# TENANTS_JSON={"enclave-a":{"token":"...","allowedModels":null},"enclave-b":{"token":"...","allowedModels":["mistral-small-3.1-24b"]}}

# Roles (from the X-OpenWebUI-User-Role header Open WebUI forwards when
# ENABLE_FORWARD_USER_INFO_HEADERS=true) allowed to call /v1/admin/* in
# addition to INSTRUCTOR_DASHBOARD_TOKEN.
ADMIN_ROLES=admin,instructor

# ---------------------------------------------------------------------------
# Model upstreams (vLLM instances on the tower)
# ---------------------------------------------------------------------------
# Per-model base URLs. vLLM binds loopback-only on the tower - this gateway
# is the only client. Override the whole registry via UPSTREAMS_JSON from
# group_vars ("the active model set is configuration, not code").
VLLM_GPTOSS_URL=http://127.0.0.1:8000
VLLM_MISTRAL_URL=http://127.0.0.1:8001
VLLM_DEVSTRAL_URL=http://127.0.0.1:8002
VLLM_GRANITE_URL=http://127.0.0.1:8003
VLLM_EMBED_URL=http://127.0.0.1:8004
VLLM_LORA_URL=http://127.0.0.1:8005

# JSON object overriding the default upstream registry entirely - see
# src/config.js defaultUpstreams for the required shape.
# UPSTREAMS_JSON=

UPSTREAM_POLL_INTERVAL_MS=15000
UPSTREAM_HEALTH_TIMEOUT_MS=3000

# Which logical model backs each of the four AI-engine (range automation)
# modes - must be a key in the upstream registry above.
AI_MODEL_LIVE=granite-3.3-8b
AI_MODEL_ASSESSMENT=mistral-small-3.1-24b
AI_MODEL_CAPACITY=granite-3.3-8b
AI_MODEL_REPORT=gpt-oss-120b

# Student chat defaults.
CHAT_DEFAULT_MODEL=gpt-oss-120b
EMBEDDING_MODEL=nomic-embed-text-v1.5
CHAT_MAX_TOKENS_CEILING=4096
CHAT_TEMPERATURE_CEILING=1.5

# Live-adaptation/capacity calls must stay fast; report generation is
# allowed to run long. Raised from the original 4000ms default - see
# docs/range-inference-tower.html, "GPU allocation and storage".
AI_LIVE_CALL_TIMEOUT_MS=8000
AI_REPORT_CALL_TIMEOUT_MS=300000

# Confidence threshold above which a live-adaptation recommendation may be
# auto-applied instead of routed to the instructor approval queue.
DEFAULT_AUTO_APPLY_CONFIDENCE_THRESHOLD=0.8

# ---------------------------------------------------------------------------
# Per-student/tenant quota (chat path only)
# ---------------------------------------------------------------------------
QUOTA_TOKENS_PER_HOUR_STUDENT=200000
QUOTA_TOKENS_PER_HOUR_TENANT=4000000
QUOTA_MAX_CONCURRENT_STUDENT=2

# ---------------------------------------------------------------------------
# Event broker: "memory" (dev/test) | "nats"
# ---------------------------------------------------------------------------
EVENT_BROKER_MODE=memory
NATS_URL=nats://127.0.0.1:4222

# ---------------------------------------------------------------------------
# Persistence: "memory" (dev/test, lost on restart) | "postgres"
# ---------------------------------------------------------------------------
# Production sets all three to "postgres" - a gateway restart (routine, via
# the 30-minute ansible-pull convergence cycle) shouldn't lose an in-flight
# report job, the audit trail, or the instructor approval queue.
JOB_STORE_MODE=memory
AUDIT_STORE_MODE=memory
APPROVAL_STORE_MODE=memory
DATABASE_URL=
