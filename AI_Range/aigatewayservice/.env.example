# AI Gateway Service configuration
PORT=8080

# Bearer token required on all /v1/* routes except /v1/health.
# Replace with real secret management (control plane vault, KMS, etc.) in production.
AI_GATEWAY_API_KEY=change-me

# Event broker mode: "memory" (dev/test) | "kafka" | "rabbitmq" | "nats"
# Only "memory" is implemented out of the box - see src/brokers/inMemoryBroker.js
# for the interface a real broker adapter must satisfy.
EVENT_BROKER_MODE=memory

# Live-adaptation calls must stay fast; report generation is allowed to run long.
AI_LIVE_CALL_TIMEOUT_MS=4000
AI_REPORT_CALL_TIMEOUT_MS=120000

# Confidence threshold above which a recommendation may be auto-applied by the
# timeline/scoring engines. This is read by callers of this service, not
# enforced here - the gateway always returns the raw confidence value.
DEFAULT_AUTO_APPLY_CONFIDENCE_THRESHOLD=0.8
